# ═══════════════════════════════════════════════════════
# Portfolio — Environment Variables
# ═══════════════════════════════════════════════════════

# ── Database (PostgreSQL — Neon free tier / Vercel Postgres) ──
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Admin Auth ──
JWT_SECRET=your-random-jwt-secret-here
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD_HASH=$2a$10$your-bcrypt-hash-here

# ── GitHub API (optional — increases rate limit from 60 to 5000/hr) ──
# GITHUB_TOKEN=ghp_your_github_token

# ── EmailJS — client-side email delivery ──
# Get credentials at https://www.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
